# Ethereal Email Test Configuration
# Ethereal provides a fake SMTP service perfect for testing
# Emails won't be delivered but you can see what would be sent

export ENABLE_EMAIL=true
export SMTP_SERVER=smtp.ethereal.email
export SMTP_PORT=587
export SENDER_EMAIL=test@ethereal.email
export SENDER_PASSWORD=test-password
export SENDER_NAME=PunterEdge Admin
